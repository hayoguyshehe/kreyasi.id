generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  CUSTOMER
  ADMIN
  SUPERADMIN
}

enum InvitationStatus {
  DRAFT
  PUBLISHED
  EXPIRED
  SUSPENDED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum PaymentMethod {
  QRIS
  VIRTUAL_ACCOUNT
  EWALLET
  CREDIT_CARD
}

enum RsvpStatus {
  HADIR
  TIDAK_HADIR
  RAGU
}

enum EventCategory {
  PERNIKAHAN
  ULANG_TAHUN
  KHITANAN_AQIQAH
  EVENT_UMUM
}

// ============================================
// MODELS
// ============================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String?  @unique
  passwordHash String?
  name         String
  role         UserRole @default(CUSTOMER)
  isSuspended  Boolean  @default(false)
  googleId     String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  invitations Invitation[]
  orders      Order[]

  // NextAuth required fields
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  @@map("users")
}

// NextAuth required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  templates Template[]

  @@map("categories")
}

model Package {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  priceIdr            Int
  activeDurationDays  Int
  maxGalleryPhotos    Int
  maxGalleryVideos    Int
  maxGuests           Int? // null = unlimited
  customDomainAllowed Boolean  @default(false)
  watermark           Boolean  @default(true)
  qrCheckinAllowed    Boolean  @default(false)
  digitalGiftAllowed  Boolean  @default(false)
  isActive            Boolean  @default(true)
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())

  orders      Order[]
  invitations Invitation[]

  @@map("packages")
}

model Template {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id])
  minPackageTier  Int // merujuk ke Package.sortOrder minimum yang boleh pakai
  previewImageUrl String
  themeConfig     Json // warna, font, layout section default
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  invitations Invitation[]

  @@map("templates")
}

model Invitation {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id])
  packageId     String
  package       Package          @relation(fields: [packageId], references: [id])
  templateId    String
  template      Template         @relation(fields: [templateId], references: [id])
  slug          String           @unique // path publik: kreyasi.id/u/{slug}
  customDomain  String?          @unique // untuk tier Eksklusif
  eventCategory EventCategory
  eventTitle    String
  eventDate     DateTime
  content       Json // lihat kontrak InvitationContent di types/index.ts
  status        InvitationStatus @default(DRAFT)
  publishedAt   DateTime?
  expiresAt     DateTime?
  viewCount     Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  guests       Guest[]
  rsvps        Rsvp[]
  guestbook    GuestbookMessage[]
  giftAccounts GiftAccount[]
  media        Media[]
  order        Order?

  @@map("invitations")
}

model Guest {
  id           String     @id @default(cuid())
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id])
  name         String
  whatsapp     String?
  personalSlug String     @unique // dipakai di query param link personal
  invitedCount Int        @default(1)
  openedAt     DateTime?
  createdAt    DateTime   @default(now())

  rsvp    Rsvp?
  checkIn CheckIn?

  @@map("guests")
}

model Rsvp {
  id                String     @id @default(cuid())
  guestId           String?    @unique
  guest             Guest?     @relation(fields: [guestId], references: [id])
  invitationId      String
  invitation        Invitation @relation(fields: [invitationId], references: [id])
  guestNameFallback String? // untuk RSVP dari pengunjung tanpa link personal
  status            RsvpStatus
  attendeeCount     Int        @default(1)
  message           String?
  createdAt         DateTime   @default(now())

  @@map("rsvps")
}

model GuestbookMessage {
  id           String     @id @default(cuid())
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id])
  name         String
  message      String
  isApproved   Boolean    @default(true)
  createdAt    DateTime   @default(now())

  @@map("guestbook_messages")
}

model GiftAccount {
  id            String     @id @default(cuid())
  invitationId  String
  invitation    Invitation @relation(fields: [invitationId], references: [id])
  type          String // BANK_TRANSFER | EWALLET | QRIS
  bankName      String?
  accountNumber String?
  accountName   String?
  qrisImageUrl  String?
  createdAt     DateTime   @default(now())

  @@map("gift_accounts")
}

model Media {
  id           String     @id @default(cuid())
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id])
  type         String // PHOTO | VIDEO | AUDIO
  url          String // path di Cloudflare R2
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())

  @@map("media")
}

model CheckIn {
  id          String   @id @default(cuid())
  guestId     String   @unique
  guest       Guest    @relation(fields: [guestId], references: [id])
  checkedInAt DateTime @default(now())
  checkedInBy String? // nama panitia/device

  @@map("check_ins")
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  packageId       String
  package         Package     @relation(fields: [packageId], references: [id])
  invitationId    String?     @unique
  invitation      Invitation? @relation(fields: [invitationId], references: [id])
  promoCodeId     String?
  promoCode       PromoCode?  @relation(fields: [promoCodeId], references: [id])
  amountIdr       Int
  status          OrderStatus @default(PENDING)
  midtransOrderId String      @unique
  createdAt       DateTime    @default(now())
  paidAt          DateTime?

  payment Payment?

  @@map("orders")
}

model Payment {
  id         String        @id @default(cuid())
  orderId    String        @unique
  order      Order         @relation(fields: [orderId], references: [id])
  method     PaymentMethod
  gatewayRef String // transaction_id dari Midtrans
  rawPayload Json // simpan webhook payload untuk audit
  paidAt     DateTime?
  createdAt  DateTime      @default(now())

  @@map("payments")
}

model PromoCode {
  id            String   @id @default(cuid())
  code          String   @unique
  discountType  String // PERCENT | FIXED
  discountValue Int
  maxUses       Int?
  usedCount     Int      @default(0)
  validFrom     DateTime
  validUntil    DateTime
  isActive      Boolean  @default(true)

  orders Order[]

  @@map("promo_codes")
}
