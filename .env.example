# Environment Variables — Kreyasi
# Copy file ini menjadi .env dan isi nilai-nilainya

# ============================================
# DATABASE (PostgreSQL / Neon Serverless Postgres)
# ============================================
# Opsi 1: PostgreSQL Lokal / VPS Coolify:
DATABASE_URL="postgresql://user:password@localhost:5432/kreyasi"
# Opsi 2: Neon Serverless Postgres (Gratis tanpa kartu kredit - bootstrap):
# DATABASE_URL="postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ============================================
# NEXTAUTH / AUTH.JS v5
# ============================================
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ============================================
# MIDTRANS PAYMENT GATEWAY
# ============================================
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"
MIDTRANS_SNAP_URL="https://app.sandbox.midtrans.com/snap/snap.js"

# ============================================
# S3 STORAGE (Cloudflare R2 atau Backblaze B2)
# ============================================
# Opsi 1: Cloudflare R2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="kreyasi-media"
R2_PUBLIC_URL=""

# Opsi 2: Backblaze B2 (Gratis 10GB tanpa kartu kredit - bootstrap)
# S3_ENDPOINT="https://s3.us-east-005.backblazeb2.com"
# S3_REGION="us-east-005"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_BUCKET_NAME="kreyasi-media"
# S3_PUBLIC_URL="https://f005.backblazeb2.com/file/kreyasi-media"

# ============================================
# APP CONFIG & MULTI-TENANCY
# ============================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Kreyasi"
NEXT_PUBLIC_ROOT_DOMAIN="kreyasi.id"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=""
NEXT_PUBLIC_MIDTRANS_SNAP_URL="https://app.sandbox.midtrans.com/snap/snap.js"
